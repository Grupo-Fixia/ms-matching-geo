# Variables de ms-matching-geo. En el compose de ms-orchestrator las entrega el servicio; para correrlo a mano, copiar a .env
# (NO subirlo a git) y cargarlo con `set -a; source .env; set +a`.

# Clave PÚBLICA de ms-users (X.509, PEM; los saltos de línea pueden ir como \n). Obligatoria: sin ella no arranca.
JWT_PUBLIC_KEY=
JWT_ISSUER=https://auth.fixia.com
JWT_AUDIENCE=https://api.fixia.com

# ms-users: búsqueda de técnicos y consulta de revocación (rutas /internal/**).
USERS_BASE_URL=http://ms-users:8080
# Clave compartida de las rutas /internal/** (la misma de ms-users y ms-services). Sin ella, la ruta interna y la pública rechazan todo.
INTERNAL_API_KEY=
# Tiempos de espera hacia ms-users: segundos ("2", "1.5") o con sufijo ("2s", "500ms").
USERS_CONNECT_TIMEOUT=1s
USERS_READ_TIMEOUT=2s
